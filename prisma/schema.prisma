generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── PLANES ──────────────────────────────────────────────────────────────────
model Plan {
  id          String   @id @default(cuid())
  nombre      String
  precio      Float
  descripcion String?
  activo      Boolean  @default(true)

  // Módulos habilitados
  modulos     String[] @default([])
  reportes    String[] @default([])

  // Límites (null = ilimitado)
  limiteProveedores  Int?
  limiteClientes     Int?
  limiteArticulos    Int?
  limiteUsuarios     Int?
  limiteFacturasCompra Int?
  limiteFacturasVenta  Int?

  empresas    Empresa[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── EMPRESAS (tenants) ───────────────────────────────────────────────────────
model Empresa {
  id                String            @id @default(cuid())
  nombre            String
  slug              String            @unique
  logoUrl           String?
  colorPrimario     String            @default("#1E3A5F")
  colorSecundario   String            @default("#2E6DA4")
  estado            EstadoEmpresa     @default(TRIAL)
  fechaVencimiento  DateTime
  planId            String
  plan              Plan              @relation(fields: [planId], references: [id])
  usuarios          Usuario[]
  categorias        Categoria[]
  articulos         Articulo[]
  proveedores       Proveedor[]
  clientes          Cliente[]
  compras           Compra[]
  ventas            Venta[]
  almacenes         Almacen[]
  condicionesPago   CondicionPago[]
  impuestos         Impuesto[]
  monedas           Moneda[]
  tiposCambio       TipoCambio[]
  periodosContables PeriodoContable[]
  timbrados         Timbrado[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  pagosCompra       PagoCompra[]
  pagosVenta        PagoVenta[]
  cajas          Caja[]
  aperturasCaja  AperturaCaja[]
  movimientosCaja MovimientoCaja[]
  auditorias Auditoria[]
  cuentasBancarias    CuentaBancaria[]
  cheques             Cheque[]
  movimientosBancarios MovimientoBancario[]
  onboardingCompletado Boolean @default(false)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usado     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}

enum EstadoEmpresa {
  PENDIENTE
  TRIAL
  ACTIVO
  SUSPENDIDO
  VENCIDO
}

// ─── USUARIOS ────────────────────────────────────────────────────────────────
model Usuario {
  id        String     @id @default(cuid())
  nombre    String
  email     String     @unique
  password  String
  rol       RolUsuario @default(OPERADOR)
  activo    Boolean    @default(true)
  empresaId String
  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  aperturasRealizadas AperturaCaja[] @relation("AperturaUsuario")
  cierresRealizados   AperturaCaja[] @relation("CierreUsuario")
  auditorias Auditoria[]
}

enum RolUsuario {
  SUPERADMIN
  ADMIN
  OPERADOR
}

// ─── MISCELANEOS ─────────────────────────────────────────────────────────────

model CondicionPago {
  id        String   @id @default(cuid())
  nombre    String // "Contado", "Crédito 30 días", etc.
  dias      Int      @default(0) // 0 = contado
  activo    Boolean  @default(true)
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  compras   Compra[]
  ventas    Venta[]
  createdAt DateTime @default(now())
}

model Impuesto {
  id             String          @id @default(cuid())
  nombre         String // "IVA 10%", "IVA 5%", "Exenta"
  porcentaje     Float           @default(0)
  activo         Boolean         @default(true)
  empresaId      String
  empresa        Empresa         @relation(fields: [empresaId], references: [id])
  articulos      Articulo[]
  compraDetalles CompraDetalle[]
  ventaDetalles  VentaDetalle[]
  createdAt      DateTime        @default(now())
}

model Moneda {
  id          String       @id @default(cuid())
  codigo      String // "PYG", "USD", "BRL"
  nombre      String // "Guaraní", "Dólar", "Real"
  simbolo     String // "Gs.", "$", "R$"
  principal   Boolean      @default(false)
  activo      Boolean      @default(true)
  empresaId   String
  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  tiposCambio TipoCambio[]
  compras     Compra[]
  ventas      Venta[]
  createdAt   DateTime     @default(now())
  cuentasBancarias CuentaBancaria[]

  @@unique([codigo, empresaId])
}

model TipoCambio {
  id        String   @id @default(cuid())
  fecha     DateTime
  valor     Float // cuántos Gs. vale 1 unidad de esta moneda
  monedaId  String
  moneda    Moneda   @relation(fields: [monedaId], references: [id])
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  createdAt DateTime @default(now())

  @@unique([monedaId, fecha])
}

model PeriodoContable {
  id          String        @id @default(cuid())
  nombre      String // "Enero 2025", "Q1 2025"
  fechaInicio DateTime
  fechaFin    DateTime
  estado      EstadoPeriodo @default(ABIERTO)
  empresaId   String
  empresa     Empresa       @relation(fields: [empresaId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum EstadoPeriodo {
  ABIERTO
  CERRADO
}

// ─── ALMACENES ───────────────────────────────────────────────────────────────
model Almacen {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  stock       Stock[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── CATEGORIAS ──────────────────────────────────────────────────────────────
model Categoria {
  id        String     @id @default(cuid())
  nombre    String
  activo    Boolean    @default(true)
  empresaId String
  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  articulos Articulo[]
  createdAt DateTime   @default(now())
}

// ─── ARTICULOS ───────────────────────────────────────────────────────────────
model Articulo {
  id             String          @id @default(cuid())
  codigo         String?
  nombre         String
  descripcion    String?
  unidadMedida   String          @default("unidad")
  inventariable  Boolean         @default(true)
  stockMinimo    Float           @default(0)
  precioCompra   Float?
  precioVenta    Float?
  impuestoId     String?
  impuesto       Impuesto?       @relation(fields: [impuestoId], references: [id])
  activo         Boolean         @default(true)
  categoriaId    String?
  categoria      Categoria?      @relation(fields: [categoriaId], references: [id])
  empresaId      String
  empresa        Empresa         @relation(fields: [empresaId], references: [id])
  stock          Stock[]
  compraDetalles CompraDetalle[]
  ventaDetalles  VentaDetalle[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([empresaId, activo])
  @@index([empresaId, nombre])
}

// ─── STOCK ───────────────────────────────────────────────────────────────────
model Stock {
  id         String   @id @default(cuid())
  cantidad   Float    @default(0)
  articuloId String
  articulo   Articulo @relation(fields: [articuloId], references: [id])
  almacenId  String
  almacen    Almacen  @relation(fields: [almacenId], references: [id])
  updatedAt  DateTime @updatedAt

  @@unique([articuloId, almacenId])
  @@index([articuloId])
  @@index([almacenId])
}

// ─── PROVEEDORES ─────────────────────────────────────────────────────────────
model Proveedor {
  id        String   @id @default(cuid())
  nombre    String
  ruc       String?
  telefono  String?
  email     String?
  direccion String?
  activo    Boolean  @default(true)
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  compras   Compra[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, activo])
}

// ─── CLIENTES ────────────────────────────────────────────────────────────────
model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  ruc       String?
  telefono  String?
  email     String?
  direccion String?
  activo    Boolean  @default(true)
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  ventas    Venta[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, activo])
}

// ─── COMPRAS (cabecera) ───────────────────────────────────────────────────────
model Compra {
  id               String              @id @default(cuid())
  nroComprobante   String?
  tipoComprobante  TipoComprobante     @default(FACTURA)
  fecha            DateTime
  condicionPagoId  String?
  condicionPago    CondicionPago?      @relation(fields: [condicionPagoId], references: [id])
  fechaVencimiento DateTime?
  monedaId         String?
  moneda           Moneda?             @relation(fields: [monedaId], references: [id])
  tipoCambio       Float               @default(1)
  subtotal         Float
  descuento        Float               @default(0)
  totalIva5        Float               @default(0)
  totalIva10       Float               @default(0)
  total            Float
  estadoPago       EstadoPago          @default(PENDIENTE)
  montoPagado      Float               @default(0)
  estado           EstadoDoc           @default(CONFIRMADA)
  observacion      String?
  proveedorId      String
  proveedor        Proveedor           @relation(fields: [proveedorId], references: [id])
  empresaId        String
  empresa          Empresa             @relation(fields: [empresaId], references: [id])
  detalles         CompraDetalle[]
  notasCredito     NotaCreditoCompra[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  pagos            PagoCompra[]

  @@index([empresaId, fecha])
  @@index([empresaId, estado])
  @@index([empresaId, estadoPago])
}

// ─── COMPRA DETALLE ───────────────────────────────────────────────────────────
model CompraDetalle {
  id             String    @id @default(cuid())
  cantidad       Float
  precioUnitario Float
  descuento      Float     @default(0)
  impuestoId     String?
  impuesto       Impuesto? @relation(fields: [impuestoId], references: [id])
  subtotal       Float
  total          Float
  compraId       String
  compra         Compra    @relation(fields: [compraId], references: [id], onDelete: Cascade)
  articuloId     String
  articulo       Articulo  @relation(fields: [articuloId], references: [id])
  createdAt      DateTime  @default(now())

  @@index([compraId])
  @@index([articuloId])
}

// ─── NOTA DE CREDITO COMPRA ───────────────────────────────────────────────────
model NotaCreditoCompra {
  id             String                     @id @default(cuid())
  nroComprobante String?
  fecha          DateTime
  tipo           TipoNotaCredito
  motivo         String?
  montoTotal     Float
  estado         EstadoDoc                  @default(CONFIRMADA)
  compraId       String
  compra         Compra                     @relation(fields: [compraId], references: [id])
  detalles       NotaCreditoCompraDetalle[]
  createdAt      DateTime                   @default(now())
}

model NotaCreditoCompraDetalle {
  id                  String            @id @default(cuid())
  cantidad            Float?
  precioUnitario      Float?
  montoAjuste         Float
  motivo              String?
  articuloId          String?
  notaCreditoCompraId String
  notaCreditoCompra   NotaCreditoCompra @relation(fields: [notaCreditoCompraId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())
}

// ─── VENTAS (cabecera) ────────────────────────────────────────────────────────
model Venta {
  id               String             @id @default(cuid())
  nroComprobante   String?
  tipoComprobante  TipoComprobante    @default(FACTURA)
  fecha            DateTime
  condicionPagoId  String?
  condicionPago    CondicionPago?     @relation(fields: [condicionPagoId], references: [id])
  fechaVencimiento DateTime?
  monedaId         String?
  moneda           Moneda?            @relation(fields: [monedaId], references: [id])
  tipoCambio       Float              @default(1)
  subtotal         Float
  descuento        Float              @default(0)
  totalIva5        Float              @default(0)
  totalIva10       Float              @default(0)
  total            Float
  estadoPago       EstadoPago         @default(PENDIENTE)
  montoPagado      Float              @default(0)
  estado           EstadoDoc          @default(CONFIRMADA)
  observacion      String?
  clienteId        String
  cliente          Cliente            @relation(fields: [clienteId], references: [id])
  empresaId        String
  empresa          Empresa            @relation(fields: [empresaId], references: [id])
  detalles         VentaDetalle[]
  notasCredito     NotaCreditoVenta[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  timbradoId       String?
  timbrado         Timbrado?          @relation(fields: [timbradoId], references: [id])
  pagos            PagoVenta[]

  @@index([empresaId, fecha])
  @@index([empresaId, estado])
  @@index([empresaId, estadoPago])
}

// ─── VENTA DETALLE ────────────────────────────────────────────────────────────
model VentaDetalle {
  id             String    @id @default(cuid())
  cantidad       Float
  precioUnitario Float
  descuento      Float     @default(0)
  impuestoId     String?
  impuesto       Impuesto? @relation(fields: [impuestoId], references: [id])
  subtotal       Float
  total          Float
  ventaId        String
  venta          Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  articuloId     String
  articulo       Articulo  @relation(fields: [articuloId], references: [id])
  createdAt      DateTime  @default(now())

  @@index([ventaId])
  @@index([articuloId])
}

// ─── NOTA DE CREDITO VENTA ────────────────────────────────────────────────────
model NotaCreditoVenta {
  id             String                    @id @default(cuid())
  nroComprobante String?
  fecha          DateTime
  tipo           TipoNotaCredito
  motivo         String?
  montoTotal     Float
  estado         EstadoDoc                 @default(CONFIRMADA)
  ventaId        String
  venta          Venta                     @relation(fields: [ventaId], references: [id])
  detalles       NotaCreditoVentaDetalle[]
  createdAt      DateTime                  @default(now())
}

model NotaCreditoVentaDetalle {
  id                 String           @id @default(cuid())
  cantidad           Float?
  precioUnitario     Float?
  montoAjuste        Float
  motivo             String?
  articuloId         String?
  notaCreditoVentaId String
  notaCreditoVenta   NotaCreditoVenta @relation(fields: [notaCreditoVentaId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
}

// ─── TIMBRADO ────────────────────────────────────────────────────────────────
model Timbrado {
  id               String   @id @default(cuid())
  numero           String // número de timbrado de la SET
  serie1           String // ej: 001
  serie2           String // ej: 001
  desde            Int // numeración desde
  hasta            Int // numeración hasta
  siguiente        Int // próximo número a usar
  fechaInicio      DateTime
  fechaVencimiento DateTime
  activo           Boolean  @default(true)
  empresaId        String
  empresa          Empresa  @relation(fields: [empresaId], references: [id])
  ventas           Venta[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── PAGOS DE COMPRAS ────────────────────────────────────────────────────────
model PagoCompra {
  id            String    @id @default(cuid())
  fecha         DateTime
  monto         Float
  medioPago     MedioPago @default(EFECTIVO)
  nroReferencia String? // nro cheque, transferencia, etc.
  observacion   String?
  compraId      String
  compra        Compra    @relation(fields: [compraId], references: [id])
  empresaId     String
  empresa       Empresa   @relation(fields: [empresaId], references: [id])
  createdAt     DateTime  @default(now())

  @@index([compraId])
  @@index([empresaId, fecha])
}

// ─── COBROS DE VENTAS ────────────────────────────────────────────────────────
model PagoVenta {
  id            String    @id @default(cuid())
  fecha         DateTime
  monto         Float
  medioPago     MedioPago @default(EFECTIVO)
  nroReferencia String?
  observacion   String?
  ventaId       String
  venta         Venta     @relation(fields: [ventaId], references: [id])
  empresaId     String
  empresa       Empresa   @relation(fields: [empresaId], references: [id])
  createdAt     DateTime  @default(now())

  @@index([ventaId])
  @@index([empresaId, fecha])
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────
enum TipoComprobante {
  FACTURA
  TICKET
  RECIBO
  NOTA_PEDIDO
}

enum EstadoPago {
  PENDIENTE
  PARCIAL
  PAGADO
}

enum EstadoDoc {
  BORRADOR
  CONFIRMADA
  ANULADA
}

enum TipoNotaCredito {
  DEVOLUCION_PRODUCTO
  AJUSTE_PRECIO
}

enum MedioPago {
  EFECTIVO
  CHEQUE
  TRANSFERENCIA
  TARJETA
  OTRO
}

// ─── CAJA ────────────────────────────────────────────────────────────────────
model Caja {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  aperturas   AperturaCaja[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([empresaId])
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

enum OrigenMovimiento {
  MANUAL
  COBRO_VENTA
  PAGO_COMPRA
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
}

model AperturaCaja {
  id                 String           @id @default(cuid())
  cajaId             String
  caja               Caja             @relation(fields: [cajaId], references: [id])
  empresaId          String
  empresa            Empresa          @relation(fields: [empresaId], references: [id])
  fechaApertura      DateTime         @default(now())
  fechaCierre        DateTime?
  saldoInicial       Float            @default(0)
  saldoFinal         Float?
  saldoReal          Float?
  diferencia         Float?
  observacionCierre  String?
  estado             EstadoCaja       @default(ABIERTA)
  usuarioAperturaId  String
  usuarioApertura    Usuario          @relation("AperturaUsuario", fields: [usuarioAperturaId], references: [id])
  usuarioCierreId    String?
  usuarioCierre      Usuario?         @relation("CierreUsuario", fields: [usuarioCierreId], references: [id])
  movimientos        MovimientoCaja[]
  createdAt          DateTime         @default(now())

  @@index([cajaId])
  @@index([empresaId])
  @@index([estado])
}

model MovimientoCaja {
  id             String           @id @default(cuid())
  aperturaCajaId String
  aperturaCaja   AperturaCaja     @relation(fields: [aperturaCajaId], references: [id])
  empresaId      String
  empresa        Empresa          @relation(fields: [empresaId], references: [id])
  tipo           TipoMovimiento
  origen         OrigenMovimiento @default(MANUAL)
  concepto       String
  monto          Float
  fecha          DateTime         @default(now())
  referenciaId   String?          // id del PagoVenta o PagoCompra
  createdAt      DateTime         @default(now())

  @@index([aperturaCajaId])
  @@index([empresaId])
}

model Auditoria {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  modulo     String   // 'VENTAS', 'COMPRAS', 'CAJA', etc.
  accion     String   // 'CREAR', 'EDITAR', 'ANULAR', 'ELIMINAR', 'PAGO', 'COBRO'
  descripcion String
  metadata   Json?    // datos adicionales (montos, ids, etc.)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([empresaId])
  @@index([usuarioId])
  @@index([modulo])
  @@index([createdAt])
}

enum TipoCheque {
  COMUN
  DIFERIDO
}

enum EstadoCheque {
  EN_CARTERA
  A_DEPOSITAR
  DEPOSITADO
  ACREDITADO
  RECHAZADO
  ANULADO
  ENTREGADO
}

enum TipoMovimientoBancario {
  DEBITO
  CREDITO
}

enum EstadoMovimientoBancario {
  PENDIENTE
  CONCILIADO
}

model Banco {
  id       String  @id @default(cuid())
  nombre   String
  codigo   String  // BNF, ITAU, VISION, etc.
  activo   Boolean @default(true)
  cuentas  CuentaBancaria[]
  cheques  Cheque[]
  createdAt DateTime @default(now())
}

model CuentaBancaria {
  id            String   @id @default(cuid())
  bancoId       String
  banco         Banco    @relation(fields: [bancoId], references: [id])
  nroCuenta     String
  descripcion   String?
  monedaId      String?
  moneda        Moneda?  @relation(fields: [monedaId], references: [id])
  saldoInicial  Float    @default(0)
  activo        Boolean  @default(true)
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  movimientos   MovimientoBancario[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([empresaId])
}

model Cheque {
  id           String       @id @default(cuid())
  tipo         TipoCheque   @default(COMUN)
  movimiento   String       // 'EMITIDO' | 'RECIBIDO'
  nroCheque    String
  bancoId      String?
  banco        Banco?       @relation(fields: [bancoId], references: [id])
  bancoNombre  String?
  monto        Float
  fechaEmision DateTime
  fechaPago    DateTime
  diasDiferido Int          @default(0)
  estado       EstadoCheque @default(EN_CARTERA)
  beneficiario String?
  emisor       String?
  observacion  String?
  pagoCompraId String?
  pagoVentaId  String?
  empresaId    String
  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  movimientosBancarios MovimientoBancario[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([empresaId])
  @@index([estado])
  @@index([fechaPago])
}

model MovimientoBancario {
  id              String                   @id @default(cuid())
  cuentaId        String
  cuenta          CuentaBancaria           @relation(fields: [cuentaId], references: [id])
  tipo            TipoMovimientoBancario
  concepto        String
  monto           Float
  fecha           DateTime
  estado          EstadoMovimientoBancario @default(PENDIENTE)
  referenciaId    String?
  referenciaTipo  String?   // 'PAGO_COMPRA' | 'COBRO_VENTA' | 'CHEQUE' | 'MANUAL'
  chequeId        String?
  cheque          Cheque?   @relation(fields: [chequeId], references: [id])
  empresaId       String
  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  createdAt       DateTime  @default(now())

  @@index([cuentaId])
